rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isValidUser(data) {
      return data.id is string &&
             data.name is string &&
             data.email is string &&
             data.role in ['SUPER_ADMIN', 'BRANCH_MANAGER', 'SECRETARY', 'INSTRUCTOR', 'STUDENT'];
    }

    function isValidBranch(data) {
      return data.id is string &&
             data.name is string &&
             data.city is string;
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && isValidUser(request.resource.data);
      allow delete: if isAuthenticated();
    }

    match /branches/{branchId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && isValidBranch(request.resource.data);
      allow delete: if isAuthenticated();
    }

    // Default catch-all for other sync documents (practical sessions, vehicles, certificates, policies, audit)
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
